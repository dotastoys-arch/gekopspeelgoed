# Kopieer dit bestand naar .env.local en vul de waarden in

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=verander-dit

# Iron session (minimaal 32 tekens willekeurige string)
SESSION_SECRET=verander-dit-naar-een-willekeurige-32-tekens-string

# Supabase database (Supabase → Settings → Database → Connection string → URI)
# Gebruik de "Transaction pooler" URL (poort 6543) voor Vercel
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Mollie betaalplatform (Mollie Dashboard → Developers → API keys)
# Gebruik test_... voor testen, live_... voor productie
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail via SMTP (Gmail: gebruik App Password via Google Account → Beveiliging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jouw@gmail.com
SMTP_PASS=jouw-app-wachtwoord
SMTP_FROM=GEK OP SPEELGOED <jouw@gmail.com>

# Publieke URL van je site (zonder trailing slash)
# Lokaal:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Productie (verander zodra live):
# NEXT_PUBLIC_BASE_URL=https://gekopspeelgoed.nl
